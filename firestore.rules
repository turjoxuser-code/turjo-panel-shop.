rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.uid in ["PASTE_YOUR_ADMIN_FIREBASE_UID_HERE"];
    }
    match /panels/{panelId} {
      allow read: if (resource.data.active == true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.transactionId is string
        && request.resource.data.transactionId.size() >= 5
        && request.resource.data.keys().hasOnly([
          "uid","email","customerName","panelId","panelName","category","duration","durationHours",
          "amount","transactionId","senderNumber","status","createdAt","deliveryLink","deliveryPassword"
        ]);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /profiles/{userId} {
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }
  }
}
